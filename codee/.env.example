# Masold at .env-be es toltsd ki.  A .env SOHA nem kerul a repoba.
#   copy .env.example .env      (PowerShell)

# --- adatbazis (1. fazis: a docker-compose.yml ezeket hasznalja) ---
POSTGRES_DB=leltariv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=leltar2026
POSTGRES_PORT=5432

# Ez megy az alkalmazasnak. Ugyanaz a jelszo, mint fent.
DATABASE_URL=postgresql+psycopg://postgres:leltar2026@localhost:5432/leltariv

# --- hitelesites ---
# local  = a szerver maga allit ki HS256 tokent az app_user tablabol (1. fazis)
# gotrue = a Supabase GoTrue adja a tokent (2. fazis)
AUTH_MODE=local
JWT_SECRET=valtsd_le_egy_legalabb_32_karakteres_veletlen_titokra
GOTRUE_URL=http://localhost:8100/auth/v1

# --- demo felhasznalo: a seed ezt hozza letre, a kliens ezt ajanlja fel ---
DEMO_USER_EMAIL=admin@leltariv.local
DEMO_USER_PASSWORD=leltar2026

# --- a ket forras-XLSX helye a gepeden (a fajlok nincsenek a repoban) ---
SOURCE_XLSX_DIR=C:/utvonal/a/ket/xlsx/mappajahoz

# --- pgAdmin ---
# Szandekosan nem .local vegu: a pgAdmin fenntartott TLD-nek tekinti, elutasitja,
# es a kontener ujrainditasi korbe kerul. Ez csak a pgAdmin belepesi cime,
# az alkalmazas demo felhasznaloja fentebb van.
PGADMIN_EMAIL=admin@leltariv.hu
PGADMIN_PASSWORD=leltar2026
PGADMIN_PORT=5050

# --- 2. fazis: Supabase-stack ---
# A stack a sajat .env-jebol el (codee/supabase/.env), es a kulcsait a
# utils/generate-keys.sh meg a utils/add-new-auth-keys.sh generalja — kezzel nem irjuk be oket.
# Ide csak az kerul at, amit a mi alkalmazasunk hasznal:
#   AUTH_MODE=gotrue
#   GOTRUE_URL=http://localhost:8100/auth/v1
#   JWT_SECRET=<a supabase/.env-bol atmasolva>
# A lepesek a SETUP.md-ben.
